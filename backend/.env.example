PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/university_attendance
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COLLECTION=sessions
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIES=false
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=60
LOGIN_LOCK_SECONDS=30

# Google Identity Services. This ID-token popup flow verifies the signature with
# Google's published keys, so no client secret is needed or used.
# The web client id is public configuration, but it lives only here: the
# frontend receives it from GET /api/auth/google/config/ and never reads a
# backend variable. Must match VITE_GOOGLE_CLIENT_ID in frontend/.env.local.
# Leave empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local default: http://localhost:8000/api/auth/google/calendar/callback/
# Production must set this to the registered HTTPS callback URL.
GOOGLE_CALENDAR_REDIRECT_URI=
# Optional Calendar ID override. Leave empty to sync to the authorized Admin's
# primary Google Calendar.
GOOGLE_CALENDAR_ID=
# The Google access policy. This is an EXPLICIT choice and is never inferred
# from whether a domain list happens to be empty. One of:
#
#   off              Google sign-in is unavailable. The default.
#   open             any valid, verified Google account may sign in and register.
#                    Identity only. A new account is activated as a Student
#                    immediately; it is never checked against a school roster and
#                    never gains Faculty or Administrator access.
#   institutional    only accounts whose verified `hd` claim is on the list below.
#   development_test only the addresses in GOOGLE_DEV_TEST_EMAILS. Local use
#                    only; the server refuses to start with this in production.
GOOGLE_ACCESS_POLICY=off
# The approved institutional Google Workspace domain(s), exactly as Google's `hd`
# claim reports them. Used ONLY by GOOGLE_ACCESS_POLICY=institutional; selecting
# that policy with an empty list is a startup error rather than a silent "open".
# Personal Gmail accounts carry no `hd` claim at all and are refused.
# GOOGLE_ALLOWED_HOSTED_DOMAINS=youruniversity.edu
# Issuers accepted on the ID token. Change only if you use a Google-hosted
# alias for the tenant.
GOOGLE_ALLOWED_ISSUERS=accounts.google.com,https://accounts.google.com
# Tolerance for clock drift between this server and Google, in seconds.
GOOGLE_CLOCK_SKEW_SECONDS=60

# Private development testing. Off by default, and the server refuses to start if
# it is ever enabled while NODE_ENV=production. Use it only to let named,
# developer-owned accounts exercise the popup flow on a local machine before the
# school confirms its domain. It is not public registration: any verified Google
# account that is not listed is rejected with 403. When a domain list is set, the
# institutional rule is applied instead and this setting has no effect.
# GOOGLE_DEV_TEST_MODE=true
# The exact Google account addresses allowed to sign in, comma separated. Matched
# case-insensitively after trimming; there is no wildcard or suffix matching.
# Only used by GOOGLE_ACCESS_POLICY=development_test.
# GOOGLE_DEV_TEST_EMAILS=your.address@gmail.com
# School authorisation is a SEPARATE fact from the domain list above, and is never
# inferred from it. Leave this false until the school actually confirms permission.
# GOOGLE_SCHOOL_APPROVED=false

# Optional SMTP delivery for verified email signup and application password setup.
# Configure a real SMTP provider, its sender, and the frontend's public base URL.
# Use the provider's required TLS mode; credentials are optional only for trusted
# unauthenticated SMTP relays. Never put these values in frontend configuration.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=University Attendance <attendance@example.edu>
# PUBLIC_APP_URL=http://localhost:5173

# Additional verification for Administrator Settings. Set a private PIN and the
# recipient address for one-time email codes. Configure SMTP delivery above too.
SU_PIN=
SU_EMAIL=

# Firebase Cloud Messaging (FCM) push delivery. Keep the service-account JSON
# private and out of source control; web config and VAPID values belong in
# frontend/.env.local. Generate a separate 32+ character token-encryption key.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FCM_TOKEN_ENCRYPTION_KEY=

# Shown as a persistent banner on every screen of the frontend. The normal app
# leaves it empty and shows nothing; a private test instance sets it so the
# environment can never be mistaken for the real one.
# DEPLOYMENT_LABEL=

# Cookie names. Rename these when running a second instance (a private Google
# test environment) on the same browser origin, so the two cannot overwrite each
# other's session. The frontend reads the CSRF name from the server.
# SESSION_COOKIE_NAME=sessionid
# CSRF_COOKIE_NAME=csrftoken

# Geofence policy for QR attendance (GST004). These are read from the
# environment so a deployment can tighten or relax them without a code change.
# Leave them unset to accept the documented defaults below.
#
# Reported accuracy worse than this is refused as too imprecise. Default 100.
# LOCATION_MAX_ACCURACY_METERS=100
#
# A fix older than this is refused as stale, so replayed coordinates fail.
# Default 120 (2 minutes).
# LOCATION_MAX_AGE_SECONDS=120
#
# LIVE TRACKING freshness, in seconds. DELIBERATELY SEPARATE from
# LOCATION_MAX_AGE_SECONDS above, because they answer different questions:
#
#   LOCATION_MAX_AGE_SECONDS (120)   the ONE-SHOT scan: the browser fixes a
#     position and scans, and the request may legitimately be delayed.
#
#   ATTENDANCE_MAX_OBSERVATION_AGE_SECONDS (30)  CONTINUOUS tracking: the app
#     samples every 10 s, so a reading older than about three samples is a
#     replayed cached position rather than a measurement of where the person is
#     now. Resending one old fix every 10 s satisfies the 30 s crediting-spacing
#     rule on every call, so without this limit a phone that never left the sofa
#     could earn a full attendance. Default 30.
#
# This value only ever TIGHTENS the general limit: if it is set wider than
# LOCATION_MAX_AGE_SECONDS, the general limit still wins. Loosening it can never
# loosen what the general policy already refuses.
# ATTENDANCE_MAX_OBSERVATION_AGE_SECONDS=30
#
# How far OUTSIDE the event radius a scan may still be accepted. The limit is
# `radius + slack`, so the default 25 means a "150 m" venue really accepts
# 175 m. Set it to 0 for a strict fence that is exactly the advertised radius -
# the isolated browser-verification instance runs this way.
# LOCATION_FENCE_SLACK_METERS=25

SQLITE_SOURCE=../legacy/django/db.sqlite3

# Encrypts the event attendance QR credential at rest so an authorized
# Administrator can re-display the CURRENT code after a refresh. Without it,
# only a hash is stored and the token cannot be recovered.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# NEVER commit this value. Rotating it invalidates stored credentials.
EVENT_QR_ENCRYPTION_KEY=
MIGRATION_BACKUP_DIR=./backups
DEMO_STUDENT_PASSWORD=student123
DEMO_FACULTY_PASSWORD=faculty123
DEMO_ADMIN_PASSWORD=admin123
