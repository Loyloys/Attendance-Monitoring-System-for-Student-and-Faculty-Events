{
  "name": "university-attendance-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.js",
    "migrate": "node scripts/migrate-sqlite.js",
    "backup": "node scripts/backup-mongodb.js",
    "restore": "node scripts/restore-mongodb.js",
    "seed": "node scripts/seed-demo.js",
    "verify:migration": "node scripts/verify-migration.js"
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.17.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
